<?xml version="1.0"?>
<robot>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <ros>
        <namespace>$(arg prefix)</namespace>
        <remapping>~/tf:=/tf</remapping>
        <remapping>~/tf_static:=/tf_static</remapping>
      </ros>
      <parameters>$(find jackal_control)/config/control.yaml</parameters>
      <!-- <update_rate>50</update_rate> -->
    </plugin>
  </gazebo>

  <gazebo reference="$(arg prefix)/imu_link">
    <sensor name="$(arg prefix)/imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>50</update_rate>
    <topic>/$(arg prefix)/imu/data</topic>
    <gz_frame_id>$(arg prefix)/imu_link</gz_frame_id>

    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </z>
      </angular_velocity>
      
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
      </plugin>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="$(arg prefix)/navsat_link">
    <sensor name="$(arg prefix)/navsat_sensor" type="navsat">
      <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat">
      </plugin>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/$(arg prefix)/navsat/fix</topic>
    </sensor>
  </gazebo>

  <gazebo reference="$(arg prefix)/base_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <gazebo reference="$(arg prefix)/chassis_link">
    <material>Gazebo/DarkGrey</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/imu_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <gazebo reference="$(arg prefix)/navsat_link">
    <material>Gazebo/DarkGrey</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/front_fender_link">
    <material>Gazebo/Yellow</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/rear_fender_link">
    <material>Gazebo/Yellow</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <!-- p3d plugin removed - odometry provided by OdometryPublisher plugin below -->

  <!-- Odometry publisher for ground truth pose and velocity data -->
  <gazebo>
    <plugin name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <odom_topic>/model/$(arg prefix)/odom_ground_truth</odom_topic>
      <odom_frame>$(arg prefix)/odom</odom_frame>
      <robot_base_frame>$(arg prefix)/base_link</robot_base_frame>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
