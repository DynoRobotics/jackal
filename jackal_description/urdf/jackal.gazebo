<?xml version="1.0"?>
<robot>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <ros>
        <namespace>$(arg prefix)</namespace>
        <remapping>~/tf:=/tf</remapping>
        <remapping>~/tf_static:=/tf_static</remapping>
      </ros>
      <parameters>$(find jackal_control)/config/control.yaml</parameters>
      <!-- <update_rate>50</update_rate> -->
    </plugin>
  </gazebo>

  <gazebo reference="$(arg prefix)/imu_link">
    <sensor name="$(arg prefix)/imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>50</update_rate>
    <topic>/$(arg prefix)/imu/data</topic>
    <gz_frame_id>$(arg prefix)/imu_link</gz_frame_id>

    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </z>
      </angular_velocity>
      
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>

    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>$(arg prefix)</namespace>
          <remapping>~/out:=/$(arg prefix)/imu/data</remapping>
        </ros>
        <body_name>$(arg prefix)/imu_link</body_name>
        <frame_name>$(arg prefix)/imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="$(arg prefix)/ps_link">
    <sensor name="$(arg prefix)/gps_sensor" type="gps">
    <plugin filename="libgazebo_ros_gps_sensor.so" name="$(arg prefix)/gps_plugin">
        <ros>
          <namespace>$(arg prefix)</namespace>
          <remapping>~/out:=gps/data</remapping>
        </ros>
      </plugin>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="$(arg prefix)/base_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <gazebo reference="$(arg prefix)/chassis_link">
    <material>Gazebo/DarkGrey</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/imu_link">
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <gazebo reference="$(arg prefix)/navsat_link">
    <material>Gazebo/DarkGrey</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/front_fender_link">
    <material>Gazebo/Yellow</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <gazebo reference="$(arg prefix)/rear_fender_link">
    <material>Gazebo/Yellow</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>

  <gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <body_name>(arg prefix)_base_link</body_name>
      <topic_name>(arg prefix)_pose</topic_name>
      <gaussian_noise>0.01</gaussian_noise>
      <frame_name>world</frame_name>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>
  </gazebo>

  <!-- To pretend like it is the camera. -->
  <gazebo>
    <plugin name="ignition::gazebo::systems::OdometryPublisher"
            filename="ignition-gazebo-odometry-publisher-system">
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <odom_topic>jackal/pose_data</odom_topic>
      <odom_frame>jackal/odom</odom_frame>
      <robot_base_frame>(arg prefix)/base_link</robot_base_frame>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
